# Solo se usa si el hosting no permite apuntar el subdominio a la carpeta "public".
# Redirige todo a public/ y protege config.php, app/ y storage/ (adjuntos privados).
RewriteEngine On
RewriteRule ^(config\.php|config\.sample\.php|cron\.php|app/.*|storage/.*)$ - [F,L]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
